<odoo>
    <record id="medical_report_view_tree" model="ir.ui.view">
        <field name="name">medical.report.view.tree</field>
        <field name="model">medical.report</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree decoration-warning="is_draft" decoration-danger="is_cancelled">
                <button
                    type="object"
                    name="action_download_report"
                    class="btn btn-sm btn-secondary"
                    icon="fa-duotone fa-file-pdf"
                    title="Download"
                    attrs="{'invisible': [('has_download_report', '=', False)]}"
                />
                <field name="id" widget="open_document_viewer" string=" " />
                <field name="has_download_report" invisible="1" />
                <field name="internal_identifier" />
                <field name="description" />
                <field name="user_id" />
                <field name="date" />
                <field name="is_draft" invisible="1" />
                <field name="is_cancelled" invisible="1" />
            </tree>
        </field>
    </record>

</odoo>
