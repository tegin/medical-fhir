<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
   <t t-name="medical_imaging_study_app.DicomApp" owl="1">
        <div>
            <t t-foreach="props.value or []" t-as="app" t-key="app.id">
                <button
                    class="btn p-0 me-1"
                    t-att-title="app.name"
                    style="width: 1.5em; height: 1.5em;"
                    t-on-click.prevent.stop="() => this.onClick(app.id)"
                >
                    <img
                        t-attf-src="/web/image/medical.imaging.app/#{app.id}/image_128"
                        class="fa-lg"
                    />
                </button>
            </t>
        </div>
    </t>
</templates>
