<odoo>
    <record model="ir.ui.view" id="medical_imaging_study_patient_tree_view">
        <field name="model">medical.imaging.study</field>
        <field
            name="inherit_id"
            ref="medical_imaging_study.medical_imaging_study_patient_tree_view"
        />
        <field name="arch" type="xml">
            <field name="instance_uid" position="before">
                <field name="app_info" widget="dicom_app" string=" " />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="medical_imaging_study_patient_kanban_view">
        <field name="model">medical.imaging.study</field>
        <field
            name="inherit_id"
            ref="medical_imaging_study.medical_imaging_study_patient_kanban_view"
        />
        <field name="arch" type="xml">
            <div name="front" position="inside">
                <field name="app_info" widget="dicom_app" />
            </div>
        </field>
    </record>

</odoo>
