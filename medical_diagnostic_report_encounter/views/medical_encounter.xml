<odoo>
    <record model="ir.ui.view" id="medical_encounter_form_view">
        <field name="name">medical.encounter.form (in medical_diagnostic_report)</field>
        <field name="model">medical.encounter</field>
        <field
            name="inherit_id"
            ref="medical_administration_encounter.medical_encounter_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//header/button[last()]" position="after">
                <button
                    type="action"
                    name="%(medical_diagnostic_report_encounter.medical_encounter_create_diagnostic_report_act_window)s"
                    class="oe_stat_button btn-warning"
                    icon="fa-file-medical-alt"
                    string="Generate Medical Report"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_report"
                    class="oe_stat_button"
                    icon="fa-file-medical-alt"
                >
                    <field
                        name="report_count"
                        widget="statinfo"
                        string="Diagnostic Reports"
                    />
                </button>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="medical_encounter_his_form_view">
        <field name="name">medical.encounter.form</field>
        <field name="model">medical.encounter</field>
        <field
            name="inherit_id"
            ref="medical_administration_encounter.medical_encounter_his_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="diagnostic_reports" string="Reports">
                    <widget
                        name="sub_view_widget"
                        model="medical.diagnostic.report"
                        domain="[('patient_id', '=', patient_id[0])]"
                        create-action="medical_diagnostic_report.medical_patient_create_diagnostic_report_act_window"
                        context="{'search_default_encounter_id': id, 'search_default_registered': 1,'search_default_final': 1, 'tree_view_ref': 'medical_diagnostic_report_encounter.medical_diagnostic_report_encounter_his_tree_view', 'default_patient_id': id}"
                    />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
