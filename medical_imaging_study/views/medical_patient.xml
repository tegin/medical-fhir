<odoo>
    <record model="ir.ui.view" id="medical_patient_his_form_view">
        <field name="name">medical.patient.form</field>
        <field name="model">medical.patient</field>
        <field name="inherit_id" ref="medical_base.medical_patient_his_form" />
        <field name="priority" eval="60" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='administration_data']" position="before">
                <page
                    name="dicom"
                    string="Dicom"
                    class="o_notebook_black"
                    icon="fa-radiation-alt"
                >
                    <widget
                        name="sub_view_widget"
                        model="medical.imaging.study"
                        domain="[('patient_id', '=', id)]"
                        context="{'default_patient_id': id, 'tree_view_ref': 'medical_imaging_study.medical_imaging_study_patient_tree_view', 'kanban_view_ref': 'medical_imaging_study.medical_imaging_study_patient_kanban_view'}"
                        favorite="0"
                    />
                </page>
            </xpath>
        </field>
    </record>

</odoo>
