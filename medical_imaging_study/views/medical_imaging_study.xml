<odoo>
    <record model="ir.ui.view" id="medical_imaging_study_form_view">
        <field name="name">medical.imaging.study.form (in medical_imaging_study)</field>
        <field name="model">medical.imaging.study</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="update_study_data"
                            type="object"
                            icon="fa-refresh"
                            string="Update data"
                        />
                    </div>
                    <group>
                        <field name="name" />
                        <field name="instance_uid" />
                        <field name="patient_id" />
                        <field name="encounter_id" />
                        <field name="modality_ids" widget="many2many_tags" />
                        <field name="study_date" />
                        <field name="series_count" />
                        <field name="instances_count" />
                        <field name="description" />
                        <field name="storage_ids" widget="many2many_tags" />
                    </group>
                    <notebook>
                        <page name="series" string="Series">
                            <field
                                name="series_ids"
                                attrs="{'readonly':[('state', 'not in', ['registered'])]}"
                            >
                                <tree editable="bottom">
                                    <field name="series_number" />
                                    <field name="instance_uid" />
                                    <field name="modality_id" />
                                    <field name="imaging_study_id" invisible="1" />
                                    <field name="state" invisible="1" />
                                    <field name="patient_id" invisible="1" />
                                    <field name="encounter_id" invisible="1" />
                                    <field name="description" />
                                    <field name="series_date" />
                                    <field name="instances_count" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="medical_imaging_study_search_view">
        <field
            name="name"
        >medical.imaging.study.search (in medical_imaging_study)</field>
        <field name="model">medical.imaging.study</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="encounter_id" />
            </search>
        </field>
    </record>
    <!-- Views of the Dicom page of the patient (sub_view_widget), without the
         buttons to create and export. Used through tree_view_ref and
         kanban_view_ref. -->
    <record model="ir.ui.view" id="medical_imaging_study_patient_tree_view">
        <field
            name="name"
        >medical.imaging.study.tree.patient (in medical_imaging_study)</field>
        <field name="model">medical.imaging.study</field>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <tree create="0" export_xlsx="0">
                <field name="instance_uid" />
                <field name="description" />
                <field name="modality_ids" widget="many2many_tags" />
                <field name="study_date" />
                <field name="series_count" />
                <field name="instances_count" />
            </tree>
        </field>
    </record>
    <record model="ir.ui.view" id="medical_imaging_study_patient_kanban_view">
        <field
            name="name"
        >medical.imaging.study.kanban.patient (in medical_imaging_study)</field>
        <field name="model">medical.imaging.study</field>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0">
                <field name="name" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click ps-0 pe-0">
                            <div class="row g-0">
                                <div class="col-2" name="front">

                                </div>
                                <div class="col-10" name="body">
                                    <div>
                                        <field name="instance_uid" />
                                        <field name="description" />
                                        <field
                                            name="modality_ids"
                                            widget="many2many_tags"
                                        />
                                        <field name="study_date" />
                                        <field name="series_count" />
                                        <field name="instances_count" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record model="ir.ui.view" id="medical_imaging_study_tree_view">
        <field name="name">medical.imaging.study.tree (in medical_imaging_study)</field>
        <field name="model">medical.imaging.study</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="encounter_id" />
            </tree>
        </field>
    </record>
    <record model="ir.actions.act_window" id="medical_imaging_study_act_window">
        <field name="name">Imaging Studies</field>
        <field name="res_model">medical.imaging.study</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    <menuitem
        id="medical_root_diagnostic"
        name="Diagnostic"
        parent="medical_base.medical_root_clinical"
        sequence="30"
    />
    <record model="ir.ui.menu" id="medical_imaging_study_root_menu">
        <field name="name">Imaging Studies</field>
        <field name="parent_id" ref="medical_base.medical_root_clinical" />
        <field name="sequence" eval="40" />
    </record>
    <record model="ir.ui.menu" id="medical_imaging_study_menu">
        <field name="name">Imaging Studies</field>
        <field name="parent_id" ref="medical_imaging_study_root_menu" />
        <field name="action" ref="medical_imaging_study_act_window" />
        <field name="sequence" eval="16" />
    </record>
</odoo>
