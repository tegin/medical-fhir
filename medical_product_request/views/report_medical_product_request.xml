<odoo>
    <template id="report_medical_product_request_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Medical Product Request</h2>
                        <p>
                            <strong>Internal ID:</strong>
                            <t t-esc="doc.internal_identifier" />
                        </p>
                        <p>
                            <strong>Patient:</strong>
                            <t t-esc="doc.patient_id.name" />
                        </p>
                        <p>
                            <strong>Encounter:</strong>
                            <t t-esc="doc.encounter_id.internal_identifier or '—'" />
                        </p>
                        <p>
                            <strong>Requester:</strong>
                            <t t-esc="doc.requester_id.name or '—'" />
                        </p>
                        <p>
                            <strong>State:</strong>
                            <t t-esc="doc.state" />
                        </p>
                        <p>
                            <strong>Validation date:</strong>
                            <t t-esc="doc.validation_date or '—'" />
                        </p>
                        <br />
                        <h4>Prescriptions</h4>
                        <table
                            class="table table-sm o_main_table table-borderless mt-4"
                        >
                            <thead style="display: table-row-group">
                                <tr>
                                    <th
                                        name="th_medical_product_template_id"
                                        class="text-start"
                                    >Product</th>
                                    <th
                                        name="th_dose_quantity"
                                        class="text-end"
                                    >Dose</th>
                                    <th name="th_dose_uom_id" class="text-end">UoM</th>
                                    <th
                                        name="th_administration_route_id"
                                        class="text-end"
                                    >Route</th>
                                    <th
                                        name="th_duration"
                                        class="text-end"
                                    >Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.product_request_ids" t-as="line">
                                    <td class="text-start">
                                        <t
                                            t-esc="line.medical_product_template_id.name"
                                        />
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="line.dose_quantity" />
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="line.dose_uom_id.name" />
                                    </td>
                                    <td class="text-end">
                                        <t
                                            t-esc="line.administration_route_id.name or '—'"
                                        />
                                    </td>
                                    <td class="text-end">
                                        <t
                                            t-if="line.duration and line.duration_uom_id"
                                        >
                                            <t t-esc="line.duration" />
                                            <t t-esc="line.duration_uom_id.name" />
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="action_report_medical_product_request" model="ir.actions.report">
        <field name="name">Medical Product Request</field>
        <field name="model">medical.product.request.order</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >medical_product_request.report_medical_product_request_document</field>
        <field
            name="print_report_name"
        >'Medical_Product_Request_' + (object.internal_identifier or
            '')</field>
        <field name="binding_model_id" ref="model_medical_product_request_order" />
        <field name="binding_type">report</field>
    </record>
</odoo>
