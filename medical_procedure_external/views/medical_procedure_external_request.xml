<odoo>
    <record model="ir.ui.view" id="medical_procedure_external_request_form_view">
        <field
            name="name"
        >medical.procedure.external.request.form (in medical_procedure_external)</field>
        <field name="model">medical.procedure.external.request</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="medical_base.medical_event_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="draft2final_action"
                    string="Issue request"
                    class="btn-success"
                    confirm="Are you sure you want to validate this external request?"
                    type="object"
                    attrs="{'invisible':[('state', '!=', 'draft')]}"
                />
                <button
                    name="cancel_action"
                    string="Cancel request"
                    confirm="Are you sure you want to cancel this external request?"
                    class="btn-danger"
                    type="object"
                    attrs="{'invisible':[('is_cancellable', '=', False)]}"
                />
            </header>
            <xpath expr="//div[@name='button_box']" position="before">
                <widget
                    name="web_ribbon"
                    title="Final"
                    bg_color="bg-success"
                    attrs="{'invisible': [('state', '!=', 'final')]}"
                />
                <widget
                    name="web_ribbon"
                    title="Cancelled"
                    bg_color="bg-danger"
                    attrs="{'invisible': [('state', '!=', 'cancelled')]}"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="show_signature"
                    class="oe_stat_button"
                    icon="fa-signature"
                    string="Signature"
                    attrs="{'invisible': [('signature_date', '=', False)]}"
                >
                    <field name="signature_date" invisible="1" />
                </button>
            </xpath>
            <xpath expr="//form" position="attributes">
                <attribute name="string">External Request</attribute>
            </xpath>
            <field name="patient_id" position="attributes">
                <attribute name="attrs">{}</attribute>
                <attribute name="invisible">1</attribute>
            </field>
            <field name="patient_id" position="before">
                <field
                    name="patient_name"
                    attrs="{'readonly':[('state', '!=', 'draft')]}"
                />
                <field name="encounter_id" />
                <field name="vat" attrs="{'readonly':[('state', '!=', 'draft')]}" />
                <field
                    name="patient_age"
                    attrs="{'readonly':[('state', '!=', 'draft')]}"
                />
                <field
                    name="patient_origin"
                    attrs="{'readonly':[('state', '!=', 'draft')]}"
                />
                <field name="is_cancellable" invisible="1" />
            </field>
            <field name="state" position="attributes">
                <attribute name="statusbar_visible">draft,final</attribute>
            </field>
            <field name="service_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="performer_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="occurrence_date" position="after">
                <field name="issued_date" />
                <field name="issued_user_id" states="final,cancelled" />
                <field name="cancel_date" states="cancelled" />
                <field name="cancel_user_id" states="cancelled" />
            </field>
            <xpath expr="//notebook/page[1]" position="before">
                <page name="composition" string="Composition">
                    <field
                        name="composition"
                        options="{'automatic_summernote_height': 1}"
                        attrs="{'readonly':[('state', '!=', 'draft')]}"
                    />
                </page>
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="medical_procedure_external_request_search_view">
        <field
            name="name"
        >medical.procedure.external.request.search (in medical_procedure_external)</field>
        <field name="model">medical.procedure.external.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="internal_identifier" />
                <separator />
                <filter
                    name="filter_not_cancelled"
                    string="Not cancelled"
                    domain="[('state', '!=', 'cancelled')]"
                />
            </search>
        </field>
    </record>
    <!-- Views of the External Procedures page of the patient (sub_view_widget),
         without the buttons to create and export. Used through tree_view_ref and
         kanban_view_ref. -->
    <record
        model="ir.ui.view"
        id="medical_procedure_external_request_patient_tree_view"
    >
        <field
            name="name"
        >medical.procedure.external.request.tree.patient (in medical_procedure_external)</field>
        <field name="model">medical.procedure.external.request</field>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <tree
                export_xlsx="0"
                default_order="fhir_state asc, create_date desc"
                decoration-warning="fhir_state == 'draft'"
            >
                <field name="id" widget="open_document_viewer" />
                <field name="internal_identifier" />
                <field name="name" />
                <field name="encounter_id" />
                <field name="issued_user_id" />
                <field name="issued_date" />
                <field name="create_date" />
                <field name="state" invisible="1" />
                <field name="fhir_state" invisible="1" />
            </tree>
        </field>
    </record>
    <record
        model="ir.ui.view"
        id="medical_procedure_external_request_patient_kanban_view"
    >
        <field
            name="name"
        >medical.procedure.external.request.kanban.patient (in medical_procedure_external)</field>
        <field name="model">medical.procedure.external.request</field>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <kanban create="0">
                <templates>
                    <field name="fhir_state" invisible="1" />
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_card oe_kanban_global_click #{record.fhir_state.raw_value== 'draft' ? 'oe_kanban_color_3' : ''}"
                        >
                            <div class="o_kanban_record_body">
                                <div class="o_kanban_primary_left">
                                    <field
                                        name="internal_identifier"
                                        class="o_kanban_record_title"
                                    />
                                    <div>
                                        <field name="name" />
                                    </div>
                                    <div t-if="record.issued_date.raw_value">
                                        <field name="issued_date" />(<field
                                            name="issued_user_id"
                                        />)
                                    </div>
                                    <div>
                                        <field name="create_date" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record model="ir.ui.view" id="medical_procedure_external_request_tree_view">
        <field
            name="name"
        >medical.procedure.external.request.tree (in medical_procedure_external)</field>
        <field name="model">medical.procedure.external.request</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="medical_base.medical_event_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
            <xpath expr="//tree" position="attributes">
                <attribute name="string">External Request</attribute>
            </xpath>
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-warning">state == 'draft'</attribute>
                <attribute name="decoration-muted">state == 'cancelled'</attribute>
            </xpath>
            <tree>
                <field name="issued_date" />
                <field name="state" invisible="1" />
            </tree>
        </field>
    </record>
    <record
        model="ir.actions.act_window"
        id="medical_procedure_external_request_act_window"
    >
        <field name="name">External Request</field>
        <field name="res_model">medical.procedure.external.request</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record model="ir.ui.menu" id="medical_procedure_external_request_menu">
        <field name="name">External Request</field>
        <field name="parent_id" ref="medical_root_request" />
        <field name="action" ref="medical_procedure_external_request_act_window" />
        <field name="sequence" eval="16" />
    </record>
</odoo>
