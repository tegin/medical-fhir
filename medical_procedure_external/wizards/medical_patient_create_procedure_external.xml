<odoo>
    <record model="ir.ui.view" id="medical_patient_create_external_request_form_view">
        <field name="name">medical.patient.create.external.request.form (in
            medical_procedure_external)</field>
        <field name="model">medical.patient.create.external.request</field>
        <field name="arch" type="xml">
            <form string="Create External Request">
                <group>
                    <field
                        name="encounter_id"
                        domain="[('patient_id', '=', patient_id), ('state', 'not in', ['finished', 'cancelled'])]"
                        context="{'default_order': 'create_date desc'}"
                        invisible="0"
                    />
                    <field name="patient_id" invisible="1" />
                    <field
                        name="template_id"
                        options="{'no_create': 1, 'no_open': 1}"
                    />
                    <field name="lang" />
                </group>
                <footer>
                    <button
                        name="generate"
                        string="Create"
                        class="btn-primary"
                        type="object"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record
        model="ir.actions.act_window"
        id="medical_patient_create_procedure_external_act_window"
    >
        <field name="name">Medical Patient Create External Request</field>
        <field name="res_model">medical.patient.create.external.request</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_patient_id': active_id}</field>
        <field name="target">new</field>
    </record>
</odoo>
