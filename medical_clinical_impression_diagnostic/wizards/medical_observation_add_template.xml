<odoo>

    <record model="ir.ui.view" id="medical_observation_add_template_form_view">
        <field name="model">medical.observation.add.template</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field
                        name="template_id"
                        domain="[('user_id', '=', uid)]"
                        options="{'no_create': True, 'no_open': True}"
                    />
                </group>
                <footer>
                    <button
                        name="doit"
                        string="Add template"
                        class="btn-primary"
                        type="object"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        model="ir.actions.act_window"
        id="medical_observation_add_template_act_window"
    >
        <field name="name">Add Template</field>
        <field name="res_model">medical.observation.add.template</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>


</odoo>
